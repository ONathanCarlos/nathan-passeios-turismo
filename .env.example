# ============================================================
# Variáveis de ambiente do projeto (exemplo)
# ------------------------------------------------------------
# Copie este arquivo para ".env" e preencha com os valores reais
# do seu backend (Lovable Cloud / Supabase).
#
#   cp .env.example .env
#
# Estas são chaves PÚBLICAS (anon/publishable), seguras para o
# cliente. NÃO coloque aqui chaves privadas / service_role.
# ============================================================

# ID do projeto backend
VITE_SUPABASE_PROJECT_ID="seu-project-id"

# Chave pública (publishable / anon key)
VITE_SUPABASE_PUBLISHABLE_KEY="sua-publishable-key"

# URL do backend
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
